# Copy to .env and fill in what you have. Everything here is optional:
# with no keys at all the app still runs on rules + the classifier.

# --- AI (optional, but much better answers) ---------------------------------
# Get a key at https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=
# Paste the model code from AI Studio's model picker, e.g. a current Flash model
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram bot (optional) ------------------------------------------------
# Talk to @BotFather -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=
# Any random string. Telegram sends it back in a header so we know the call is real.
TELEGRAM_SECRET=change-me-to-something-random

# --- Link reputation (optional) ---------------------------------------------
# console.cloud.google.com -> enable "Safe Browsing API" -> create an API key
SAFE_BROWSING_KEY=

# --- Storage ----------------------------------------------------------------
# SQLite by default. For Supabase use the pooler URL, it is rewritten automatically.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_URL=

# --- Web --------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*
DEFAULT_LANG=en
ENABLE_TTS=true
